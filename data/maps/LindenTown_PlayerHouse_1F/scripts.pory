mapscripts LindenTown_PlayerHouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: LindenTown_PlayerHouse_1F_InitialTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LINDEN_INTRO_STATE, 1: LindenTown_PlayerHouse_1F_InitialScene
    ]
}

# Initial Mum Scene

script LindenTown_PlayerHouse_1F_MumTalkScript {
    lock
    faceplayer
    if (var(VAR_LINDEN_INTRO_STATE) == 2) {
        msgbox(format("Mum: Have you been talking to Pip? They've been waiting for you to come over!"), MSGBOX_DEFAULT)
        msgbox(format("Mum: You should head over to their house!"), MSGBOX_DEFAULT)
        closemessage
    } else {
        // Heal pokemon if the player has any, since this is the first time they talk to their mom in the game.
        msgbox(format("Mum: Hey son!"), MSGBOX_DEFAULT)
        closemessage
    }
    release
}

script LindenTown_PlayerHouse_1F_InitialTransition {
    if (var(VAR_LINDEN_INTRO_STATE) == 1) {
        setobjectxyperm(1, 1, 3)
        setobjectmovementtype(1, MOVEMENT_TYPE_FACE_UP)
    }
}

script LindenTown_PlayerHouse_1F_InitialScene {
    lockall
    applymovement(1, LindenTown_PlayerHouse_1F_MumWalkToPlayer)
    waitmovement(0)
    msgbox(format("Mum: There you are!\nBreakfast is on the table."), MSGBOX_DEFAULT)
    msgbox(format("Mum: Pip's been waiting you.\nYou'd better head over to their house!"), MSGBOX_DEFAULT)
    closemessage
    applymovement(1, LindenTown_PlayerHouse_1F_MumWalktoTable)
    waitmovement(0)
    setvar(VAR_LINDEN_INTRO_STATE, 2)
    releaseall
}

movement LindenTown_PlayerHouse_1F_MumWalkToPlayer {
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
}

movement LindenTown_PlayerHouse_1F_MumWalktoTable {
    walk_down
    walk_down
    walk_left
    walk_left
    walk_down
    walk_in_place_left
}